---
import Base from '../layouts/Base.astro';
import Shader from '../components/Shader.astro';
---

<Base title="Página no encontrada">
  <section class="relative flex h-[100svh] min-h-[600px] items-center justify-center overflow-hidden text-center">
    <div class="absolute inset-0"><Shader mode="lens" lens="0,0.05,0.22,0.11" lensPortrait="0,0.05,0.16,0.08" /></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_40%_at_50%_50%,rgba(3,19,15,.85),rgba(3,19,15,0))]"></div>
    <div class="wrap relative">
      <div class="eyebrow">Error 404</div>
      <h1 class="mt-5 text-[clamp(48px,7vw,100px)] font-bold leading-[.95] tracking-[-0.055em]">Esto no se <em class="accent">percibe</em>.</h1>
      <p class="mt-6 text-[19px] text-bruma">La página que buscas no existe o cambió de lugar.</p>
      <a href="/" class="btn btn-primary mt-9">Volver al inicio →</a>
    </div>
  </section>
</Base>
