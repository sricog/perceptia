---
import Base from '../layouts/Base.astro';
import Shader from '../components/Shader.astro';
import Process from '../components/sections/Process.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { services } from '../data/site';
---

<Base title="Servicios" description="Websites y landing pages, MVPs, desarrollo a la medida y automatizaciones. Diseño y desarrollo de software en Colombia y Puerto Rico.">
  <header class="grain relative overflow-hidden pb-20 pt-40 md:pb-28 md:pt-52">
    <div class="absolute inset-0 opacity-70"><Shader mode="chrome" variant="0.9" scale="0.5" /></div>
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(0deg,#03130F_0%,rgba(3,19,15,.6)_45%,rgba(3,19,15,.2)_100%)]"></div>
    <div class="wrap relative">
      <div class="eyebrow pc-rise">Servicios</div>
      <h1 class="pc-rise mt-5 max-w-[14ch] text-[clamp(48px,7vw,104px)] font-bold leading-[.95] tracking-[-0.055em]" style="--d:.1s">
        Lo que <em class="accent">construimos</em> contigo
      </h1>
      <p class="pc-rise mt-6 max-w-[560px] text-[19px] leading-[1.55] text-bruma" style="--d:.2s">
        Cuatro formas de trabajar juntos. Todas empiezan igual: entendiendo tu negocio antes de escribir una línea de código.
      </p>
    </div>
  </header>

  <section class="wrap flex flex-col gap-5 pb-28 pt-6 md:pb-36">
    {
      services.map((s, i) => (
        <article id={s.slug} class="grid scroll-mt-28 gap-2.5 rounded-[26px] border border-salvia/14 bg-card p-2.5 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-reveal>
          <div class:list={['relative min-h-[240px] overflow-hidden rounded-[18px] lg:min-h-[420px]', i % 2 && 'lg:order-2']}>
            <Shader mode={s.shader.mode as any} variant={s.shader.variant} scale={s.shader.scale} px={s.shader.px} lens={s.shader.lens} />
          </div>
          <div class="flex flex-col justify-between gap-10 p-5 md:p-9">
            <div class="flex flex-col gap-4">
              <span class="font-mono text-[12px] font-medium tracking-[0.14em] text-aqua">{s.n}</span>
              <h2 class="text-[clamp(32px,3.4vw,48px)] font-semibold leading-[1.02] tracking-[-0.04em]">{s.title}</h2>
              <p class="max-w-[560px] text-[17px] leading-[1.6] text-salvia">{s.long}</p>
            </div>
            <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
              <ul class="grid gap-x-8 gap-y-0 sm:grid-cols-2">
                {s.includes.map((it) => (
                  <li class="flex items-center gap-3 border-t border-salvia/14 py-3 text-[15px] text-niebla">
                    <span class="size-1.5 flex-none rounded-full bg-aqua shadow-[0_0_8px_#14E0A5]" />
                    {it}
                  </li>
                ))}
              </ul>
              <div class="flex flex-col gap-3 sm:items-end">
                {s.price ? (
                  <div class="flex flex-col gap-1.5 sm:items-end">
                    <span class="mono-tag">Desde</span>
                    <span class="text-[34px] font-[650] leading-none tracking-[-0.04em]">{s.price}</span>
                  </div>
                ) : (
                  <span class="mono-tag">Solicitar propuesta</span>
                )}
                <a href={`/contacto?servicio=${s.slug}`} class="btn btn-primary h-12 px-6 text-[15px]">Cotizar →</a>
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <Process />
  <CtaBand />
</Base>
