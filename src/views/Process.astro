---
import Base from '../layouts/Base.astro';
import Shader from '../components/Shader.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import BookingForm from '../components/BookingForm';
import BinocularMark from '../components/BinocularMark.astro';
import Accent from '../components/Accent.astro';
import { site } from '../data/site';
import { useI18n } from '../i18n';
const { t, lang, href } = useI18n(Astro.url);
const p = t.processPage;
const b = t.booking;
const steps = t.process.steps.map((s, i) => ({ t: s.t, n: String(i + 1).padStart(2, '0') }));
// Un icono por principio, en el mismo orden que `process.principles`.
const icons = [
  'M4 6h11v8H9l-3 3v-3H4zM9 17h7l2 2v-2h2v-7h-2', // contacto directo
  'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5M9 15l2 2 4-4', // avances cada semana
  'M14.5 9.5a4 4 0 1 0-3 3.9L13 15h2v2h2v2h3v-3l-5.4-5.4a4 4 0 0 0-.1-1.1zM9.5 8.5h.01', // todo a tu nombre
  'M4 20V4M4 20h16M8 16v-4M12 16V8M16 16v-6', // decisiones con datos
];
---

<Base title={p.title} description={p.description} route="process">
  <header class="grain relative overflow-hidden pb-16 pt-40 md:pb-24 md:pt-52">
    <div class="absolute inset-0 opacity-75"><Shader mode="lens" lenses lens="0.55,0.05,0.2,0.1" variant="2" scale="0.5" /></div>
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(0deg,#03130F_0%,rgba(3,19,15,.7)_50%,rgba(3,19,15,.3)_100%)]"></div>
    <div class="wrap relative">
      <div class="eyebrow pc-rise">{p.eyebrow}</div>
      <h1 class="pc-rise mt-5 max-w-[15ch] text-[clamp(3rem,7vw,6.5rem)] font-bold leading-[.95] tracking-[-0.055em]" style="--d:.1s">
        <Accent parts={p.h1} />
      </h1>
      <p class="pc-rise mt-6 max-w-[35rem] text-[1.1875rem] leading-[1.55] text-bruma" style="--d:.2s">{p.lead}</p>
      <ol class="pc-rise mt-10 flex flex-wrap items-center gap-2" style="--d:.3s">
        {
          steps.map((s) => (
            <li>
              <a
                href={`#${t.ids.process}-${s.n}`}
                class="flex items-center gap-2.5 rounded-full border border-niebla/15 bg-noche/50 px-4 py-2.5 text-[0.875rem] font-medium text-niebla backdrop-blur-xl transition-colors hover:border-aqua/60 hover:text-niebla"
              >
                <span class="font-mono text-[0.6875rem] tracking-[0.12em] text-aqua">{s.n}</span>
                {s.t}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </header>

  <ProcessTimeline />

  <section class="wrap pb-28 md:pb-36">
    <h2 class="h-section mb-12" data-reveal><Accent parts={t.process.principlesTitle} /></h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.process.principles.map((pr, i) => (
          <div
            class="group relative flex flex-col gap-4 overflow-hidden rounded-[1.625rem] border border-salvia/14 bg-card p-7 transition-[border-color] duration-500 hover:border-aqua/45 md:p-8"
            data-spot
            data-reveal
            style={`--d:${i * 0.08}s`}
          >
            <span class="grid size-12 place-items-center rounded-2xl border border-aqua/30 bg-aqua/8 text-aqua transition-[background,color] duration-300 group-hover:bg-aqua group-hover:text-noche">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[i]} />
              </svg>
            </span>
            <h3 class="mt-2 text-[1.375rem] font-semibold leading-tight tracking-[-0.03em]">{pr.t}</h3>
            <p class="text-[0.9375rem] leading-[1.55] text-salvia">{pr.d}</p>
            <span class="spot pointer-events-none absolute inset-0" aria-hidden="true" />
          </div>
        ))
      }
    </div>
  </section>

  <section id={b.id} class="wrap grid scroll-mt-24 grid-cols-[minmax(0,1fr)] gap-12 pb-28 md:pb-36 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:gap-16">
    <div class="flex flex-col gap-6 lg:sticky lg:top-28 lg:self-start" data-reveal>
      <BinocularMark id="booking" size={56} metal />
      <h2 class="h-section"><Accent parts={b.title} /></h2>
      <p class="max-w-[26.25rem] text-[1.125rem] leading-[1.55] text-salvia">{b.lead}</p>
      <ul class="mt-2 flex flex-col font-mono text-[0.8125rem] font-medium tracking-[0.06em]">
        {
          b.facts.map((f, i) => (
            <li class:list={['flex items-center gap-3 border-t border-salvia/18 py-4', i === b.facts.length - 1 && 'border-b']}>
              <span class="size-1.5 rounded-full bg-aqua shadow-[0_0_0.5rem_#14E0A5]" aria-hidden="true" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="min-h-[40rem] min-w-0" data-reveal style="--d:.1s">
      <BookingForm client:only="react" t={b} lang={lang} whatsappNumber={site.whatsappNumber} consent={{ t: t.consent, terms: href('terms'), privacy: href('privacy') }} />
    </div>
  </section>
</Base>
