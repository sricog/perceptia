---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Studio from '../components/sections/Studio.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import Process from '../components/sections/Process.astro';
import Reach from '../components/sections/Reach.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Accent from '../components/Accent.astro';
import { services } from '../data/site';
import { useI18n } from '../i18n';
const { t, href } = useI18n(Astro.url);
---

<Base route="home">
  <Hero />
  <Studio />

  <section id={t.ids.services} class="wrap scroll-mt-24 pb-28 pt-24 md:pb-36 md:pt-32">
    <SectionHead link={{ href: href('services'), label: t.homeServices.link }}>
      <Accent parts={t.homeServices.title} />
    </SectionHead>
    {/* Bento: 7 + 5 columnas arriba, 5 + 7 abajo. */}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-12">
      {services.map((s, i) => <ServiceCard s={s} delay={(i % 2) * 0.1} class={i % 3 === 0 ? 'lg:col-span-7' : 'lg:col-span-5'} />)}
    </div>
  </section>

  <section id={t.ids.projects} class="scroll-mt-24 pb-28 pt-14 md:pb-36">
    <div class="wrap">
      <SectionHead link={{ href: href('projects'), label: t.homeProjects.link }}>
        <Accent parts={t.homeProjects.title} />
      </SectionHead>
    </div>
    <ProjectsShowcase id="home-grid" />
  </section>

  <Process />
  <Reach />
  <CtaBand />
</Base>
