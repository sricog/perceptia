---
import { useI18n } from '../i18n';
interface Props { target: string }
const { target } = Astro.props;
const { t } = useI18n(Astro.url);
const opts = [
  { f: 'all', label: t.projects.all },
  { f: 'web', label: t.projects.filters.web },
  { f: 'app', label: t.projects.filters.app },
];
---

<div
  data-filter-group={target}
  role="group"
  aria-label={t.projects.filterLabel}
  class="flex gap-1.5 whitespace-nowrap rounded-full border border-salvia/20 p-1.25 text-[0.875rem] font-medium"
>
  {
    opts.map((o, i) => (
      <button
        type="button"
        data-filter={o.f}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class="cursor-pointer rounded-full px-4.5 py-2.5 leading-none text-salvia transition-colors hover:text-niebla aria-pressed:bg-niebla aria-pressed:text-noche"
      >
        {o.label}
      </button>
    ))
  }
</div>
