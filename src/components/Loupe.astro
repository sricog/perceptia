---
/**
 * Lupa binocular: dos círculos con la proporción del isotipo (separación = radio)
 * que siguen el cursor y amplían la imagen de su `[data-loupe-area]`.
 * La mueve `loupes()` en scripts/projects.ts; solo aparece con mouse o trackpad.
 */
interface Props { label?: string }
const { label } = Astro.props;
---

<div data-loupe class="loupe" aria-hidden="true">
  <div data-loupe-view class="loupe-view"></div>
  <svg viewBox="0 0 120 80" class="loupe-ring">
    <path d="M60 5.359A40 40 0 0 1 60 74.641A40 40 0 0 1 60 5.359Z" fill="#14E0A5" fill-opacity=".16"></path>
    <circle cx="40" cy="40" r="39.4" fill="none" stroke="#EEF5F2" stroke-opacity=".85" stroke-width="1.2" vector-effect="non-scaling-stroke"></circle>
    <circle cx="80" cy="40" r="39.4" fill="none" stroke="#EEF5F2" stroke-opacity=".85" stroke-width="1.2" vector-effect="non-scaling-stroke"></circle>
  </svg>
  {label && <span class="loupe-label">{label}</span>}
</div>

<style>
  .loupe {
    --w: 12.75rem;
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: var(--w);
    aspect-ratio: 3 / 2;
    pointer-events: none;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 0.3s,
      scale 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .loupe:global(.is-on) {
    opacity: 1;
    scale: 1;
  }
  .loupe-view {
    position: absolute;
    inset: 0;
    background-color: #03130f;
    background-repeat: no-repeat;
    /* Dos círculos de radio = medio alto, centrados a 1/3 y 2/3 del ancho. */
    --r: calc(var(--w) / 3);
    mask:
      radial-gradient(circle var(--r) at 33.333% 50%, #000 calc(100% - 1px), transparent 100%),
      radial-gradient(circle var(--r) at 66.667% 50%, #000 calc(100% - 1px), transparent 100%);
    filter: saturate(1.08) contrast(1.04);
  }
  .loupe-ring {
    position: absolute;
    inset: 0;
    overflow: visible;
    filter: drop-shadow(0 0 0.875rem rgb(20 224 165 / 0.45)) drop-shadow(0 0.625rem 1.875rem rgb(0 0 0 / 0.6));
  }
  .loupe-label {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.75rem);
    translate: -50% 0;
    white-space: nowrap;
    border-radius: 62.4375rem;
    background: var(--color-niebla);
    padding: 0.4375rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--color-noche);
  }
</style>
