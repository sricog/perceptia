---
/**
 * Galería de /proyectos: mosaico de tarjetas con las capturas reales de cada sitio
 * (escritorio en un marco de navegador + móvil en un teléfono). La primera tarjeta visible
 * va a todo el ancho, con la información al lado; las demás en dos columnas. Si al final
 * queda una sola, también ocupa todo el ancho. Todo se recalcula solo con el filtro porque
 * los selectores ignoran las tarjetas ocultas.
 */
import { Image } from 'astro:assets';
import { projects, domainOf } from '../data/site';
import { useI18n, fill } from '../i18n';
import BrowserFrame from './BrowserFrame.astro';
interface Props { id?: string }
const { id = 'proyectos-grid' } = Astro.props;
const { t } = useI18n(Astro.url);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div id={id} class="pgrid grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
  {
    projects.map((p, i) => {
      const m = t.projects.meta[p.id];
      return (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          data-type={p.kind}
          data-spot
          data-reveal
          style={`--d:${(i % 2) * 0.1}s`}
          class="card group relative flex flex-col overflow-hidden rounded-[1.625rem] border border-salvia/14 bg-card text-niebla transition-[border-color,box-shadow] duration-500 hover:border-aqua/45 hover:text-niebla hover:shadow-[0_1.875rem_5rem_-1.875rem_rgba(20,224,165,.5)]"
        >
          <div class="stage relative aspect-[16/11] overflow-hidden">
            <BrowserFrame domain={domainOf(p.url)} compact class="browser absolute left-[7%] top-[10%] w-[74%] rounded-[0.75rem]">
              <Image
                src={p.shot}
                alt={fill(t.projects.shotAlt, { name: p.name })}
                widths={[480, 760, 1100]}
                sizes="(min-width:768px) 40vw, 70vw"
                class="aspect-[16/10] w-full object-cover object-top"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </BrowserFrame>
            <div class="phone absolute bottom-[8%] right-[6%] w-[19%] overflow-hidden rounded-[9%/4.2%] border border-niebla/25 bg-noche p-[0.8%]">
              <Image
                src={p.shotMobile}
                alt=""
                widths={[160, 280, 420]}
                sizes="(min-width:768px) 11vw, 19vw"
                class="aspect-[500/1082] w-full rounded-[8%/3.7%] object-cover object-top"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </div>
          </div>

          <div class="info relative flex flex-1 flex-col gap-3 border-t border-salvia/12 p-6 md:p-8">
            <div class="flex items-center justify-between gap-4">
              <span class="font-mono text-[0.75rem] font-medium tracking-[0.14em] text-aqua">{pad(i + 1)}</span>
              <span class="mono-tag">{t.projects.kinds[p.kind]}</span>
            </div>
            <h2 class="name text-[clamp(1.625rem,2.6vw,2.25rem)] font-semibold leading-[1.05] tracking-[-0.035em]">{p.name}</h2>
            <p class="text-[1rem] leading-[1.5] text-salvia">{m.sector} · {m.place}</p>
            <span class="mt-3 inline-flex items-center gap-2 self-start rounded-full border border-salvia/30 px-4 py-2.5 font-mono text-[0.75rem] leading-none tracking-[0.04em] text-niebla transition-[background,color,border-color] duration-300 group-hover:border-aqua group-hover:bg-aqua group-hover:text-noche">
              {t.projects.visit}
            </span>
          </div>
          <span class="spot pointer-events-none absolute inset-0" aria-hidden="true"></span>
        </a>
      );
    })
  }
</div>

<style>
  .stage {
    background:
      radial-gradient(70% 90% at 50% 115%, rgb(20 224 165 / 0.22), transparent 70%),
      radial-gradient(rgb(143 176 165 / 0.16) 1px, transparent 1px) 0 0 / 1.25rem 1.25rem;
  }
  .stage :global(.browser) {
    box-shadow: 0 1.75rem 3.5rem -1.25rem rgb(0 0 0 / 0.85);
    transition: translate 0.9s var(--ease-out-expo);
  }
  .phone {
    box-shadow: 0 1.5rem 3rem -0.75rem rgb(0 0 0 / 0.95);
    transition: translate 0.9s var(--ease-out-expo);
  }
  /* Al pasar el cursor, las dos pantallas se separan un poco (profundidad). */
  .card:hover .stage :global(.browser) {
    translate: -0.375rem -0.375rem;
  }
  .card:hover .phone {
    translate: 0.375rem -0.75rem;
  }

  @media (min-width: 768px) {
    /* Tarjeta ancha: la primera visible y la última si queda sola en su fila. */
    .pgrid > .card:nth-child(1 of :not([hidden])),
    .pgrid > .card:nth-last-child(1 of :not([hidden])):nth-child(even of :not([hidden])) {
      grid-column: span 2;
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .pgrid > .card:nth-child(1 of :not([hidden])) .info,
    .pgrid > .card:nth-last-child(1 of :not([hidden])):nth-child(even of :not([hidden])) .info {
      border-top: 0;
      border-left: 1px solid rgb(143 176 165 / 0.12);
      justify-content: center;
      gap: 1.125rem;
      padding: clamp(1.75rem, 3.4vw, 3.5rem);
    }
    .pgrid > .card:nth-child(1 of :not([hidden])) .name,
    .pgrid > .card:nth-last-child(1 of :not([hidden])):nth-child(even of :not([hidden])) .name {
      font-size: clamp(2.25rem, 4vw, 3.75rem);
      line-height: 1;
      letter-spacing: -0.045em;
    }
  }
</style>
