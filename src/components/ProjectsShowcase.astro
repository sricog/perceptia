---
/**
 * Proyectos del home: carril horizontal con la captura real de cada sitio dentro de un marco
 * de navegador. Es scroll nativo con `scroll-snap` (deslizar, trackpad o teclado); los botones
 * y la barra de avance los maneja `rails()` en scripts/projects.ts. El carril va de borde a
 * borde de la ventana; las tarjetas se alinean con el margen del resto del sitio.
 */
import { Image } from 'astro:assets';
import { projects, domainOf } from '../data/site';
import { useI18n, fill } from '../i18n';
import BrowserFrame from './BrowserFrame.astro';
interface Props { id: string }
const { id } = Astro.props;
const { t } = useI18n(Astro.url);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div id={id} data-rail>
  <ol class="rail -my-8 flex snap-x snap-mandatory gap-5 overflow-x-auto py-8 md:gap-7" aria-label={t.projects.index} data-rail-track>
    {
      projects.map((p, i) => {
        const m = t.projects.meta[p.id];
        return (
          <li class="w-[min(80vw,46rem)] flex-none snap-start" data-reveal style={`--d:${Math.min(i, 2) * 0.1}s`}>
            <a href={p.url} target="_blank" rel="noopener" class="group block text-niebla hover:text-niebla">
              <BrowserFrame
                domain={domainOf(p.url)}
                class="rounded-[1.25rem] transition-[border-color,box-shadow] duration-500 group-hover:border-aqua/70 group-hover:shadow-[0_0_3.75rem_-0.75rem_rgba(20,224,165,.55)]"
              >
                <Image
                  src={p.shot}
                  alt={fill(t.projects.shotAlt, { name: p.name })}
                  widths={[480, 760, 1100, 1440]}
                  sizes="(min-width:920px) 46rem, 80vw"
                  class="aspect-[16/10] w-full object-cover object-top transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </BrowserFrame>
              <div class="mt-5 grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 gap-y-2">
                <span class="font-mono text-[0.75rem] tracking-[0.08em] text-aqua">{pad(i + 1)}</span>
                <span class="text-[clamp(1.5rem,2.3vw,2rem)] font-semibold leading-tight tracking-[-0.03em]">{p.name}</span>
                <span class="mono-tag">{t.projects.kinds[p.kind]}</span>
                <span class="col-start-2 col-end-4 text-[0.9375rem] text-salvia">{m.sector} · {m.place}</span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ol>

  <div class="wrap mt-8 flex items-center gap-6 md:mt-10">
    <div class="h-px flex-1 overflow-hidden bg-salvia/20" aria-hidden="true"><div class="rail-thumb h-full origin-left bg-aqua"></div></div>
    <span class="font-mono text-[0.75rem] tracking-[0.1em] text-salvia"><span data-rail-n>01</span> / {pad(projects.length)}</span>
    <div class="flex gap-2">
      <button type="button" class="rail-btn" aria-label={t.projects.prev} data-rail-prev disabled>←</button>
      <button type="button" class="rail-btn" aria-label={t.projects.next} data-rail-next>→</button>
    </div>
  </div>
</div>

<style>
  .rail {
    --gutter: clamp(1.25rem, 6.6vw, 6rem); /* igual a .wrap */
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    /* Solo se desplaza en horizontal: si el carril pudiera moverse en vertical (aunque sea unos
       píxeles) se «tragaría» la rueda del mouse y la página no bajaría. */
    overflow-y: hidden;
  }
  /* Las tarjetas entran solo con opacidad: el desplazamiento vertical del revelado normal
     crearía justo ese desborde vertical dentro del carril. */
  .rail > [data-reveal] {
    transform: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
  /* `--p` (0…1) la pone el script; sin script la barra queda llena. */
  .rail-thumb {
    transform: scaleX(var(--p, 1));
  }
  .rail-btn {
    display: grid;
    place-items: center;
    width: 2.875rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(143 176 165 / 0.3);
    font: 500 1rem/1 var(--font-mono);
    color: var(--color-niebla);
    cursor: pointer;
    transition: background 0.3s, color 0.3s, border-color 0.3s, opacity 0.3s;
  }
  .rail-btn:hover:not(:disabled) {
    background: var(--color-niebla);
    border-color: var(--color-niebla);
    color: var(--color-noche);
  }
  .rail-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>
