---
/**
 * Proyectos del home: franja infinita con la captura real de cada sitio dentro de un marco de
 * navegador. Se desplaza sola, sin pausas, y se puede arrastrar con el mouse o el dedo; el
 * movimiento lo maneja `marquees()` en scripts/marquee.ts. La lista va dos veces seguidas para
 * que el final de una copia empalme con el inicio de la otra. La segunda copia es decorativa
 * (oculta a lectores de pantalla y fuera del tabulado).
 */
import { Image } from 'astro:assets';
import { projects, domainOf } from '../data/site';
import { useI18n, fill } from '../i18n';
import BrowserFrame from './BrowserFrame.astro';
interface Props { id: string }
const { id } = Astro.props;
const { t } = useI18n(Astro.url);
const copies = [false, true]; // ¿es la copia decorativa?
---

<div id={id} class="marquee" style={`--n:${projects.length}`} data-marquee data-reveal>
  <div class="marquee-track">
    {
      copies.map((dup) => (
        <ol class="marquee-list" aria-label={dup ? undefined : t.projects.index} aria-hidden={dup ? 'true' : undefined}>
          {projects.map((p, i) => {
            const m = t.projects.meta[p.id];
            return (
              <li class="marquee-item">
                <a href={p.url} target="_blank" rel="noopener" tabindex={dup ? -1 : undefined} draggable="false" class="group block text-niebla hover:text-niebla">
                  <BrowserFrame
                    domain={domainOf(p.url)}
                    class="rounded-[1.25rem] transition-[border-color,box-shadow] duration-500 group-hover:border-aqua/70 group-hover:shadow-[0_0_3.75rem_-0.75rem_rgba(20,224,165,.55)]"
                  >
                    <Image
                      src={p.shot}
                      alt={dup ? '' : fill(t.projects.shotAlt, { name: p.name })}
                      widths={[480, 760, 1100, 1440]}
                      sizes="(min-width:920px) 46rem, 80vw"
                      class="aspect-[16/10] w-full object-cover object-top transition-transform duration-[1.2s] ease-out group-hover:scale-[1.03]"
                      loading={!dup && i < 2 ? 'eager' : 'lazy'}
                      draggable="false"
                    />
                  </BrowserFrame>
                  <div class="mt-4 flex flex-col gap-1.5 md:mt-5 md:gap-2">
                    <span class="mono-tag">{t.projects.kinds[p.kind]}</span>
                    <span class="text-[clamp(1.375rem,2.3vw,2rem)] font-semibold leading-tight tracking-[-0.03em]">{p.name}</span>
                    <span class="text-[0.875rem] text-salvia md:text-[0.9375rem]">{m.sector} · {m.place}</span>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    --card: min(80vw, 46rem); /* ancho de cada tarjeta */
    --gap: 1.25rem;
    /* Vuelta de la animación de respaldo sin JS (con JS la velocidad está en marquee.ts). */
    --dur: calc(var(--n) * 6s);
    overflow: hidden;
    /* Aire para la sombra de hover sin que la recorte el overflow. */
    padding-block: 2rem;
    margin-block: -2rem;
  }
  @media (min-width: 48rem) {
    .marquee {
      --gap: 1.75rem;
      --dur: calc(var(--n) * 9s);
    }
  }
  /* La revelación normal sube la sección; aquí basta la opacidad. */
  .marquee[data-reveal] {
    transform: none;
  }
  .marquee[data-ready] {
    cursor: grab;
    /* El gesto horizontal es de la franja; el vertical sigue bajando la página. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Las tarjetas son enlaces (cursor de mano por defecto): se muestra el de agarrar para que se
     note que la franja se arrastra. El brillo de hover sigue indicando que se pueden abrir. */
  .marquee[data-ready] a {
    cursor: grab;
  }
  .marquee[data-dragging],
  .marquee[data-dragging] a {
    cursor: grabbing;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  /* Respaldo sin JS: la misma franja con animación CSS. Con JS la mueve marquee.ts. */
  .marquee:not([data-ready]) .marquee-track {
    animation: pcMarq var(--dur) linear infinite;
  }
  .marquee-list {
    display: flex;
  }
  /* Separación con margen (no `gap`) para que las dos copias midan exactamente lo mismo y el
     bucle empalme sin salto. */
  .marquee-item {
    flex: none;
    width: var(--card);
    margin-right: var(--gap);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee:not([data-ready]) .marquee-track {
      animation: none;
    }
  }
</style>
