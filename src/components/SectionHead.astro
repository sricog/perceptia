---
interface Props {
  eyebrow?: string;
  link?: { href: string; label: string };
  class?: string;
}
const { eyebrow, link, class: cls } = Astro.props;
---

<div class:list={['mb-12 flex flex-wrap items-end justify-between gap-6', cls]} data-reveal>
  <div class="flex flex-col gap-5">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h2 class="h-section"><slot /></h2>
  </div>
  {
    link && (
      <a href={link.href} class="group font-mono text-[0.8125rem] tracking-[0.06em] text-salvia hover:text-niebla">
        {link.label} <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
    )
  }
  <slot name="aside" />
</div>
