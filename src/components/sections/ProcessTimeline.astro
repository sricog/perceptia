---
/**
 * Proceso detallado de /proceso: línea de tiempo vertical. Cada etapa trae su explicación larga,
 * lo que pasa en ella y su ilustración. Un haz recorre la línea con el scroll y enciende el punto
 * de cada etapa; las ilustraciones arrancan al entrar en pantalla (`timelines()` en effects.ts).
 * La versión corta del home y /servicios es sections/Process.astro.
 */
import ProcessViz from '../ProcessViz.astro';
import { useI18n } from '../../i18n';
const { t } = useI18n(Astro.url);
const steps = t.process.steps.map((s, i) => ({ ...s, n: String(i + 1).padStart(2, '0') }));
---

<section class="wrap pb-28 pt-6 md:pb-36">
  <ol class="tl relative" data-timeline>
    <div class="absolute bottom-0 left-[0.4375rem] top-2 w-px bg-salvia/20" aria-hidden="true"></div>
    <div class="tl-beam absolute left-[0.375rem] top-2 w-[0.1875rem] rounded-full" aria-hidden="true"></div>
    {
      steps.map((s, i) => (
        <li
          id={`${t.ids.process}-${s.n}`}
          class:list={[
            'tl-step relative grid scroll-mt-28 gap-8 pl-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:pl-16',
            i < steps.length - 1 && 'pb-20 md:pb-28',
          ]}
          data-tl-step
        >
          <span class="tl-dot absolute left-0 top-1.5 size-4 rounded-full border border-aqua bg-noche" aria-hidden="true" />
          <div class="flex flex-col gap-5" data-reveal>
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-[0.75rem] font-medium tracking-[0.14em] text-aqua">{s.n}</span>
              <span class="rounded-full border border-salvia/25 px-2.5 py-1 font-mono text-[0.6875rem] uppercase leading-none tracking-[0.1em] text-salvia">{s.tag}</span>
            </div>
            <h2 class="text-[clamp(2rem,3.6vw,3.25rem)] font-semibold leading-[1.02] tracking-[-0.04em]">{s.t}</h2>
            <p class="max-w-[30rem] text-[1.0625rem] leading-[1.6] text-salvia">{s.long}</p>
            <div class="mt-2">
              <span class="mono-tag">{t.process.stage}</span>
              <ul class="mt-3 flex flex-col">
                {s.details.map((it) => (
                  <li class="flex items-center gap-3 border-t border-salvia/14 py-3.5 text-[1rem] leading-[1.4] text-niebla">
                    <span class="size-1.5 flex-none rounded-full bg-aqua shadow-[0_0_0.5rem_#14E0A5]" aria-hidden="true" />
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="overflow-hidden rounded-[1.625rem] border border-salvia/16 bg-card lg:self-start" data-reveal style="--d:.1s">
            {/* Las ilustraciones se amplían: aquí el recuadro es más grande que en el home. */}
            <ProcessViz step={i} class="h-60 md:h-80 md:[&>*]:scale-[1.3] lg:h-[25rem] lg:[&>*]:scale-[1.45]" />
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* `--p` (0…1) la pone el script: cuánto de la línea ya pasó por el centro de la pantalla. */
  .tl-beam {
    height: calc(var(--p, 0) * (100% - 0.5rem));
    background: linear-gradient(180deg, rgb(20 224 165 / 0), #14e0a5);
    box-shadow: 0 0 1.125rem #14e0a5;
  }
  .tl-dot {
    transition: background 0.5s, box-shadow 0.5s;
  }
  .tl-step[data-on] .tl-dot {
    background: var(--color-aqua);
    box-shadow: 0 0 1.125rem rgb(20 224 165 / 0.8);
  }
</style>
