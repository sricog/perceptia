---
import { Image } from 'astro:assets';
import { projects } from '../../data/site';
const p = projects[0];
---

<section class="relative flex flex-col items-center overflow-x-clip px-5 pb-28 pt-14 text-center md:pb-36">
  <div class="pointer-events-none absolute left-1/2 top-[300px] h-[620px] w-[1200px] max-w-[160vw] -translate-x-1/2 rounded-[50%] bg-aqua/20 blur-[90px]"></div>
  <div class="eyebrow relative" data-reveal>03 · Proyecto destacado</div>
  <h2 class="relative mt-5.5 text-[clamp(64px,7.8vw,112px)] font-bold leading-[.95] tracking-[-0.06em]" data-reveal style="--d:.08s">
    Mi<em class="accent">Quarto</em>
  </h2>
  <p class="relative mt-4.5 text-[19px] leading-normal text-salvia" data-reveal style="--d:.16s">App web · diseño, desarrollo y lanzamiento</p>
  <div class="relative mt-12 w-full max-w-[1080px] [perspective:1600px] md:mt-16">
    <a
      href={p.url}
      target="_blank"
      rel="noopener"
      data-tilt
      class="block origin-top rounded-[22px] border border-niebla/14 bg-[linear-gradient(180deg,#22443C,#0A1E19)] p-2.5 shadow-[0_60px_120px_-30px_rgba(0,0,0,.9),inset_0_1px_0_rgba(238,245,242,.18)] will-change-transform md:rounded-[30px] md:p-3.5"
      style="transform:rotateX(24deg) scale(.95)"
      aria-label="Ver MiQuarto en vivo"
    >
      <div class="aspect-[16/10] overflow-hidden rounded-[14px] bg-noche md:rounded-[18px]">
        <Image src={p.image} alt="Mockup de la plataforma MiQuarto en laptop y móvil" widths={[640, 1080, 1600]} sizes="(min-width:1100px) 1080px, 100vw" class="size-full object-cover" />
      </div>
    </a>
  </div>
</section>
