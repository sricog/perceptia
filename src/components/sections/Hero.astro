---
/**
 * Hero «Convergencia»: dos lentes que se acercan con el scroll mientras un registro de
 * compilación avanza; al cruzarse forman el isotipo de Perceptia y entra el titular.
 * La coreografía vive en `hero()` de scripts/effects.ts; sin JS o con movimiento reducido
 * se muestra directamente el estado final.
 */
import Shader from '../Shader.astro';
import Accent from '../Accent.astro';
import { useI18n } from '../../i18n';
const { t, href } = useI18n(Astro.url);
const { words, log: buildLog } = t.hero;
---

<section data-hero class="hero relative" aria-label={t.hero.label}>
  <div data-hero-stage class="grain sticky top-0 h-[100svh] min-h-[600px] overflow-hidden">
    <div class="absolute inset-0">
      <Shader mode="lens" lens="0,0.17,0.19,0.095" lensPortrait="0,0.2,0.1,0.05" />
    </div>
    <div class="hero-shade pointer-events-none absolute inset-0"></div>

    <ol class="hero-log" aria-hidden="true">
      {
        buildLog.map((line) => (
          <li data-step>
            <span class="hero-log-prompt">&gt;</span>
            <span class="hero-log-text" set:html={line} />
            <span class="hero-log-status" />
          </li>
        ))
      }
    </ol>

    <div class="hero-cue" aria-hidden="true">
      <span>{t.hero.cue}</span>
      <span class="hero-cue-line"></span>
    </div>

    <div class="hero-final wrap absolute inset-x-0 bottom-12 z-[2] flex flex-col items-center text-center md:bottom-18">
      <h1 class="pc-rise text-[clamp(46px,6.55vw,94px)] font-bold leading-none tracking-[-0.055em] [text-wrap:balance]" style="--d:.5s">
        <Accent parts={t.hero.title} />
      </h1>
      <div
        class="pc-rise mt-5.5 grid h-[34px] text-[clamp(19px,1.8vw,26px)] leading-[1.3] tracking-[-0.02em] text-bruma"
        style="--d:.75s"
      >
        <span>
          {t.hero.lead}{' '}<span data-rotator data-interval="2600" class="inline-grid text-left [&>*]:[grid-area:1/1]">
            {
              words.map(([s, i], k) => (
                <span data-word hidden={k > 0} class="whitespace-nowrap">
                  {s} <em class="accent">{i}</em>
                </span>
              ))
            }
          </span>
        </span>
      </div>
      <div class="pc-rise mt-9 flex flex-wrap justify-center gap-3" style="--d:.95s">
        <a href={href('contact')} class="btn btn-primary">{t.hero.primary}</a>
        <a href={href('projects')} class="btn btn-ghost">{t.hero.secondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sin JS / movimiento reducido: una sola pantalla con el estado final. */
  .hero {
    height: 100svh;
    min-height: 600px;
  }
  .hero[data-armed] {
    height: 240svh;
  }
  .hero-shade {
    background: linear-gradient(0deg, rgb(3 19 15 / 0.92) 0%, rgb(3 19 15 / 0.55) 24%, rgb(3 19 15 / 0) 46%);
    opacity: var(--f, 1);
  }

  .hero-log,
  .hero-cue {
    display: none;
  }

  /* Registro de compilación bajo las lentes. Cada línea: pending → active → done. */
  [data-armed] .hero-log {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 13px/1.5 var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    opacity: var(--o, 0);
    transform: translate3d(var(--x, 50vw), var(--y, 50vh), 0) translate(-50%, 0);
    will-change: transform, opacity;
  }
  .hero-log li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--color-salvia);
    transition: opacity 0.35s ease, transform 0.5s var(--ease-out-expo), color 0.35s ease;
  }
  .hero-log li:not([data-state]) {
    opacity: 0;
    transform: translateY(8px);
  }
  .hero-log li[data-state='active'] {
    color: var(--color-niebla);
  }
  .hero-log li[data-state='done'] {
    opacity: 0.55;
  }
  .hero-log-prompt {
    color: var(--color-aqua);
  }
  .hero-log-text :global(b) {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-niebla);
  }
  .hero-log-status {
    min-width: 1ch;
  }
  .hero-log li[data-state='active'] .hero-log-status::after {
    content: '▍';
    color: var(--color-aqua);
    animation: heroBlink 1s steps(1) infinite;
  }
  .hero-log li[data-state='done'] .hero-log-status::after {
    content: '✓';
    color: var(--color-aqua);
  }
  /* El último paso, ya completo, queda resaltado. */
  .hero-log li:last-child[data-state='done'] {
    opacity: 1;
    color: var(--color-niebla);
  }
  @keyframes heroBlink {
    50% { opacity: 0; }
  }
  @media (max-width: 480px) {
    [data-armed] .hero-log {
      font-size: 12px;
    }
  }

  [data-armed] .hero-cue {
    position: absolute;
    inset-inline: 0;
    bottom: 32px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-salvia);
    opacity: var(--o, 0);
    pointer-events: none;
  }
  .hero-cue-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: rgb(143 176 165 / 0.2);
  }
  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-aqua);
    box-shadow: 0 0 8px var(--color-aqua);
    animation: heroCue 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes heroCue {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }

  [data-armed] .hero-final {
    opacity: var(--f, 0);
    transform: translateY(calc((1 - var(--f, 0)) * 48px));
    will-change: transform, opacity;
  }
  [data-armed]:not([data-final]) .hero-final {
    pointer-events: none;
  }
</style>
