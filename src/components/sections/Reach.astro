---
import Accent from '../Accent.astro';
import { places, minorPoints, type PlaceId } from '../../data/site';
import { useI18n, fill } from '../../i18n';
const { t } = useI18n(Astro.url);
const list = t.reach.places.map((p) => ({ ...p, ...places[p.id as PlaceId] }));
const config = JSON.stringify({
  hub: 'co',
  lang: t.htmlLang,
  minor: minorPoints,
  places: list.map(({ id, loc, zone }) => ({ id, loc, zone })),
});
// Lado de cada etiqueta respecto a su punto, para que no se encimen (Medellín, San Juan y Miami están cerca).
const side: Record<string, string> = { co: 'b', pr: 'r', us: 'l', es: 't' };
// Marcas del dial exterior cada 5° (más largas cada 30°).
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
---

<section class="wrap grid items-center gap-12 overflow-x-clip pb-24 pt-10 md:pb-30 lg:grid-cols-[minmax(0,640px)_1fr] lg:gap-18">
  <div class="relative mx-auto aspect-square w-full max-w-[640px]" data-reveal="focus">
    <!-- Halo y dial (decorativos) -->
    <div class="pointer-events-none absolute inset-[8%] rounded-full bg-[radial-gradient(circle,rgba(20,224,165,.16)_0%,rgba(14,59,48,.25)_45%,transparent_70%)] blur-2xl"></div>
    <svg viewBox="-100 -100 200 200" class="dial-ticks pointer-events-none absolute inset-0 size-full" aria-hidden="true">
      <g>
        {
          ticks.map((d) => (
            <line
              x1="0"
              y1="-97"
              x2="0"
              y2={d % 30 === 0 ? -92.5 : -95.2}
              stroke={d % 90 === 0 ? '#14E0A5' : '#8FB0A5'}
              stroke-opacity={d % 30 === 0 ? 0.7 : 0.3}
              stroke-width=".35"
              transform={`rotate(${d})`}
            />
          ))
        }
      </g>
    </svg>
    <svg viewBox="-100 -100 200 200" class="dial pointer-events-none absolute inset-0 size-full" aria-hidden="true">
      <circle r="97" fill="none" stroke="#8FB0A5" stroke-opacity=".14" stroke-width=".3"></circle>
      <g font-family="Geist Mono Variable, monospace" font-size="3.2" fill="#8FB0A5" fill-opacity=".7" text-anchor="middle" letter-spacing=".4">
        <text y="-87.5">N 0°</text>
        <text y="90.5">S 180°</text>
        <text x="89" y="1.2">E</text>
        <text x="-89" y="1.2">W</text>
      </g>
    </svg>

    <div data-globe={config} class="globe absolute inset-[7%]">
      <canvas class="size-full cursor-grab touch-pan-y" aria-hidden="true"></canvas>
      {
        list.map((p) => (
          <div data-label={p.id} data-side={side[p.id] ?? 't'} class="g-label" style={`--v: var(--cobe-visible-${p.id}, 0)`}>
            <span class="g-dot" />
            <span>{p.city}</span>
            <time data-clock={p.zone} class="text-aqua" aria-label={fill(t.reach.localTime, { city: p.city })}>--:--</time>
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex flex-col gap-6" data-reveal style="--d:.1s">
    <h2 class="h-section"><Accent parts={t.reach.title} /></h2>
    <p class="max-w-[460px] text-[19px] leading-[1.55] text-salvia">{t.reach.body}</p>
    <ul class="mt-2 flex flex-col border-b border-salvia/18">
      {
        list.map((p) => (
          <li>
            <button
              type="button"
              data-place={p.id}
              aria-pressed="false"
              class="place group grid w-full cursor-pointer grid-cols-[auto_1fr_auto] items-center gap-x-4 border-t border-salvia/18 py-4 text-left transition-colors"
            >
              <span class="relative flex size-2.5">
                <span class="absolute inset-0 rounded-full bg-aqua/60 opacity-0 transition-opacity group-aria-pressed:animate-[pcPing_1.6s_ease-out_infinite] group-aria-pressed:opacity-100" />
                <span class="relative size-2.5 rounded-full border border-aqua/70 transition-colors group-hover:bg-aqua group-aria-pressed:bg-aqua" />
              </span>
              <span class="flex flex-col gap-0.5">
                <span class="text-[17px] font-medium text-niebla">{p.name}</span>
                <span class="font-mono text-[12px] tracking-[0.06em] text-salvia">{p.city} · {p.tz}</span>
              </span>
              <time data-clock={p.zone} class="font-mono text-[20px] font-medium tabular-nums tracking-[0.02em] text-niebla transition-colors group-hover:text-aqua group-aria-pressed:text-aqua">
                --:--
              </time>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="font-mono text-[12px] tracking-[0.06em] text-salvia/80">{t.reach.hint}</p>
  </div>
</section>

<style>
  .globe canvas {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .globe:global(.is-ready) canvas {
    opacity: 1;
  }
  .globe:global(.is-dragging) canvas {
    cursor: grabbing;
  }
  /* Las marcas van en su propio <svg> y se gira el elemento entero: girar un <g> dentro del SVG
     tomaba un eje corrido y el anillo se desplazaba hacia un lado con el tiempo. */
  .dial-ticks {
    transform-origin: 50% 50%;
    animation: dialSpin 120s linear infinite;
  }
  @keyframes dialSpin {
    to { rotate: 360deg }
  }

  /* Etiqueta anclada a cada país (va dentro del ancla que crea cobe). */
  .g-label {
    position: absolute;
    left: 0;
    bottom: 10px;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
    border: 1px solid rgb(143 176 165 / 0.22);
    border-radius: 999px;
    background: rgb(3 19 15 / 0.78);
    backdrop-filter: blur(8px);
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--color-niebla);
    /* --v vale 0 detrás del globo; delante cobe deja un valor inválido y gana el 1 por defecto. */
    opacity: var(--v);
    transition:
      opacity 0.35s,
      border-color 0.3s,
      scale 0.4s var(--ease-out-expo);
    pointer-events: none;
  }
  .g-label[data-side='b'] {
    bottom: auto;
    top: 10px;
  }
  .g-label[data-side='r'] {
    bottom: auto;
    top: 0;
    translate: 12px -50%;
  }
  .g-label[data-side='l'] {
    bottom: auto;
    top: 0;
    translate: calc(-100% - 12px) -50%;
  }
  .g-label:global(.is-focus) {
    border-color: var(--color-aqua);
    scale: 1.12;
  }
  .g-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-aqua);
    box-shadow: 0 0 8px var(--color-aqua);
  }
  /* Antes de que el script mueva la etiqueta a su ancla, no se muestra. */
  [data-globe] > .g-label {
    display: none;
  }
  .place:hover,
  .place[aria-pressed='true'] {
    background: linear-gradient(90deg, rgb(20 224 165 / 0.06), transparent 70%);
  }
  @media (prefers-reduced-motion: reduce) {
    .dial-ticks {
      animation: none;
    }
  }
</style>
