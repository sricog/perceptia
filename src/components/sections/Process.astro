---
import SectionHead from '../SectionHead.astro';
import { steps } from '../../data/site';
---

<section id="proceso" class="wrap scroll-mt-24 pb-28 pt-16 md:pb-36">
  <SectionHead eyebrow="05 · Proceso" class="mb-16 md:mb-18">Cómo <em class="accent">trabajamos</em></SectionHead>
  <div class="relative grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4" data-progress>
    <div class="absolute bottom-0 left-[7px] top-0 w-px bg-salvia/20 lg:bottom-auto lg:left-0 lg:right-0 lg:top-[7px] lg:h-px lg:w-auto"></div>
    <div class="beam absolute left-[6px] top-0 w-[3px] rounded-[3px] lg:left-0 lg:top-[6px] lg:h-[3px]"></div>
    {
      steps.map((s, i) => (
        <div class="step relative flex flex-col gap-3.5 pl-10 lg:pl-0 lg:pt-11" data-reveal style={`--d:${i * 0.1}s;--i:${i}`}>
          <div class="dot absolute left-0 top-0 size-4 rounded-full border border-aqua bg-noche transition-[background,box-shadow] duration-500" />
          <span class="font-mono text-[12px] font-medium tracking-[0.14em] text-aqua">{s.n}</span>
          <h3 class="text-[26px] font-semibold leading-[1.1] tracking-[-0.03em] md:text-[28px]">{s.t}</h3>
          <p class="text-[16px] leading-[1.55] text-salvia">{s.d}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  [data-progress] {
    --p: 0.38;
  }
  .beam {
    height: calc(var(--p) * 100%);
    background: linear-gradient(180deg, rgb(20 224 165 / 0), #14e0a5);
    box-shadow: 0 0 18px #14e0a5;
  }
  @media (min-width: 1024px) {
    .beam {
      width: calc(var(--p) * 100%);
      height: 3px;
      background: linear-gradient(90deg, rgb(20 224 165 / 0), #14e0a5);
    }
  }
  /* Un paso se enciende cuando el haz lo alcanza */
  .step .dot {
    --on: clamp(0, (var(--p) * 4 - var(--i)) * 10, 1);
    background: color-mix(in srgb, #14e0a5 calc(var(--on) * 100%), #03130f);
    box-shadow: 0 0 calc(var(--on) * 18px) rgb(20 224 165 / 0.8);
  }
</style>
