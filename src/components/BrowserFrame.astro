---
/**
 * Marco de navegador para las capturas de proyectos: tres puntos, el dominio con el punto
 * «en vivo» y la captura (slot). `compact` reduce la barra para marcos pequeños.
 */
interface Props { domain: string; compact?: boolean; class?: string }
const { domain, compact = false, class: cls } = Astro.props;
---

<div class:list={['overflow-hidden border border-niebla/12 bg-hondo', cls]}>
  <div class:list={['flex items-center border-b border-niebla/10', compact ? 'gap-2 px-3 py-2' : 'gap-3 px-4 py-3']}>
    <span class="flex gap-1.5" aria-hidden="true">
      {[0, 1, 2].map(() => <span class:list={['rounded-full bg-musgo', compact ? 'size-1.5' : 'size-2']} />)}
    </span>
    <span
      class:list={[
        'mx-auto flex min-w-0 items-center gap-2 rounded-full bg-noche/70 font-mono leading-none tracking-[0.04em] text-bruma',
        compact ? 'px-2.5 py-1 text-[0.5625rem]' : 'px-3.5 py-1.5 text-[0.6875rem]',
      ]}
    >
      <span class="relative flex size-1.5 flex-none" aria-hidden="true">
        <span class="absolute inset-0 animate-[pcPing_1.8s_ease-out_infinite] rounded-full bg-aqua"></span>
        <span class="relative size-1.5 rounded-full bg-aqua"></span>
      </span>
      <span class="truncate">{domain}</span>
    </span>
    <span class:list={['font-mono leading-none text-salvia transition-colors group-hover:text-aqua', compact ? 'text-[0.6875rem]' : 'text-[0.875rem]']} aria-hidden="true">↗</span>
  </div>
  <div class="overflow-hidden"><slot /></div>
</div>
