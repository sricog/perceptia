---
import { tech } from '../data/site';
---

<div
  class="pc-marquee-host hairline overflow-hidden border-y py-6.5 [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]"
  aria-label="Tecnologías con las que trabajamos"
>
  <div class="pc-marquee" style="--dur:40s">
    {
      [...tech, ...tech].map((t, i) => (
        <div class="flex items-center gap-10 pr-10 font-mono text-[13px] font-medium uppercase leading-none tracking-[0.14em] text-salvia" aria-hidden={i >= tech.length ? 'true' : undefined}>
          {t}
          <span class="size-1.25 rounded-full bg-aqua shadow-[0_0_8px_#14E0A5]" />
        </div>
      ))
    }
  </div>
</div>
