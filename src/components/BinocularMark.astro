---
/**
 * Isotipo binocular de Perceptia: dos lentes y la intersección (vesica) en aqua.
 * Portado de `mark()` del diseño Perceptia Home.
 */
interface Props {
  size?: number; // alto en px
  id: string;
  metal?: boolean;
  sw?: number;
  glow?: boolean;
  anim?: boolean;
  delay?: number;
  blur?: number;
  class?: string;
}
const { size = 22, id, metal = false, sw = 2.5, glow = true, anim = false, delay = 0, blur = 6, class: cls } = Astro.props;
const V = 'M60 14.02A30 30 0 0 1 60 65.98A30 30 0 0 1 60 14.02Z';
const stroke = metal ? `url(#${id}s)` : '#EEF5F2';
const lensStyle = (dx: number) =>
  anim ? `--dx:${dx}px;animation:pcLens 1.5s cubic-bezier(.16,1,.3,1) ${delay}s both` : undefined;
const ves = 'transform-box:fill-box;transform-origin:center;';
const glowAnim = anim
  ? `pcVes .9s ease ${delay + 1}s both, pcGlow 3.2s ease-in-out ${delay + 1.9}s infinite`
  : 'pcGlow 3.2s ease-in-out infinite';
---

<svg
  viewBox="-10 -10 140 100"
  width={size * 1.4}
  height={size}
  class={cls}
  style="display:block;overflow:visible"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={`${id}s`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFFFFF"></stop>
      <stop offset=".3" stop-color="#8D9894"></stop>
      <stop offset=".55" stop-color="#F2F6F4"></stop>
      <stop offset="1" stop-color="#56645F"></stop>
    </linearGradient>
    <filter id={`${id}b`} x="-100%" y="-100%" width="300%" height="300%">
      <feGaussianBlur stdDeviation={blur}></feGaussianBlur>
    </filter>
  </defs>
  <circle cx="45" cy="40" r="30" fill="none" stroke={stroke} stroke-width={sw} style={lensStyle(-32)}></circle>
  <circle cx="75" cy="40" r="30" fill="none" stroke={stroke} stroke-width={sw} style={lensStyle(32)}></circle>
  {glow && <path d={V} fill="#14E0A5" filter={`url(#${id}b)`} style={`${ves}animation:${glowAnim}`}></path>}
  <path
    d={V}
    fill="#14E0A5"
    style={anim ? `${ves}animation:pcVes .9s cubic-bezier(.16,1,.3,1) ${delay + 1}s both` : undefined}
  ></path>
</svg>
