---
/**
 * Isotipo oficial de Perceptia: dos círculos del mismo radio, separados un radio,
 * con la intersección (vesica) calada. Se dibuja como dos medialunas para poder
 * animarlas por separado; en reposo el resultado es idéntico al logo original.
 *
 * Geometría (viewBox 120×80): r = 40, centros (40,40) y (80,40),
 * intersecciones en (60, 40 ± 34.641).
 */
interface Props {
  size?: number; // alto en px
  id?: string;
  metal?: boolean; // relleno con degradado metálico en lugar de color plano
  anim?: boolean; // las medialunas entran desde los lados
  delay?: number;
  class?: string;
}
const { size = 22, id = `pm${Math.random().toString(36).slice(2, 8)}`, metal = false, anim = false, delay = 0, class: cls } = Astro.props;

const LEFT = 'M60 5.359A40 40 0 1 0 60 74.641A40 40 0 0 1 60 5.359Z';
const RIGHT = 'M60 5.359A40 40 0 1 1 60 74.641A40 40 0 0 0 60 5.359Z';
const fill = metal ? `url(#${id}s)` : 'currentColor';
const lensStyle = (dx: number) =>
  anim ? `--dx:${dx}px;animation:pcLens 1.5s cubic-bezier(.16,1,.3,1) ${delay}s both` : undefined;
---

<svg
  viewBox="0 0 120 80"
  width={size * 1.5}
  height={size}
  class={cls}
  style="display:block;overflow:visible"
  aria-hidden="true"
>
  {
    metal && (
      <defs>
        <linearGradient id={`${id}s`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#FFFFFF" />
          <stop offset=".3" stop-color="#8D9894" />
          <stop offset=".55" stop-color="#F2F6F4" />
          <stop offset="1" stop-color="#56645F" />
        </linearGradient>
      </defs>
    )
  }
  <path d={LEFT} fill={fill} style={lensStyle(-24)}></path>
  <path d={RIGHT} fill={fill} style={lensStyle(24)}></path>
</svg>
