---
/** Fondo WebGL en vivo (pc-shader del diseño). Se pausa fuera de pantalla. */
interface Props {
  mode: 'lens' | 'chrome' | 'dither' | 'globe';
  lens?: string;
  lensPortrait?: string;
  lenses?: boolean;
  variant?: string;
  scale?: string;
  px?: string;
  /** Tope de densidad de píxeles (por defecto 1.25) y de píxeles totales del canvas. */
  maxDpr?: string;
  budget?: string;
  /** Baja la resolución sola si el equipo no alcanza a dibujar fluido. */
  adaptive?: boolean;
  class?: string;
}
const { mode, lens, lensPortrait, lenses, variant, scale, px, maxDpr, budget, adaptive, class: cls } = Astro.props;
---

<pc-shader
  mode={mode}
  lens={lens}
  lens-portrait={lensPortrait}
  lenses={lenses ? '1' : undefined}
  variant={variant}
  scale={scale}
  px={px}
  max-dpr={maxDpr}
  budget={budget}
  adaptive={adaptive ? '' : undefined}
  class:list={['block size-full', cls]}
  aria-hidden="true"></pc-shader>
