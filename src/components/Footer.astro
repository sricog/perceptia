---
import { siInstagram } from 'simple-icons';
import BinocularMark from './BinocularMark.astro';
import { site, whatsappUrl } from '../data/site';
import { useI18n } from '../i18n';
const { t, href } = useI18n(Astro.url);
const year = new Date().getFullYear();
---

<footer class="hairline wrap overflow-hidden border-t pt-16">
  <div class="grid grid-cols-2 gap-10 text-[0.9375rem] leading-[1.9] text-salvia md:grid-cols-[2fr_1fr_1fr_1fr]">
    <div class="col-span-2 flex flex-col gap-4 md:col-span-1">
      <a href={href('home')} aria-label={t.a11y.home} class="flex items-center gap-2.5 text-[1.125rem] font-semibold tracking-[-0.02em] text-niebla hover:text-niebla">
        <BinocularMark id="foot" size={40} metal />
      </a>
      <span>{t.meta.tagline}</span>
    </div>
    <div class="flex flex-col">
      <span class="mono-tag leading-[2.6] text-niebla">{t.footer.site}</span>
      <a class="text-salvia hover:text-niebla" href={href('services')}>{t.nav.services}</a>
      <a class="text-salvia hover:text-niebla" href={href('projects')}>{t.nav.projects}</a>
      <a class="text-salvia hover:text-niebla" href={href('process')}>{t.nav.process}</a>
      <a class="text-salvia hover:text-niebla" href={href('contact')}>{t.nav.contact}</a>
    </div>
    <div class="flex flex-col">
      <span class="mono-tag leading-[2.6] text-niebla">{t.footer.contact}</span>
      <a class="text-salvia hover:text-niebla" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="text-salvia hover:text-niebla" href={whatsappUrl(t.whatsapp)} target="_blank" rel="noopener">{site.whatsappDisplay}</a>
      <a
        class="mt-3 inline-flex size-10 items-center justify-center rounded-full border border-salvia/25 text-salvia transition-colors hover:border-aqua hover:text-aqua"
        href={site.instagram}
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
        title="Instagram"
      >
        <svg viewBox="0 0 24 24" class="size-[1.125rem] fill-current" aria-hidden="true"><path d={siInstagram.path} /></svg>
      </a>
    </div>
    <div class="flex flex-col">
      <span class="mono-tag leading-[2.6] text-niebla">{t.footer.legal}</span>
      <a class="text-salvia hover:text-niebla" href={href('terms')}>{t.footer.terms}</a>
      <a class="text-salvia hover:text-niebla" href={href('privacy')}>{t.footer.privacy}</a>
      <span>© {year} Perceptia</span>
    </div>
  </div>
  <div
    class="wordmark -mb-[0.22em] mt-10 select-none text-center font-bold leading-none tracking-[-0.065em]"
    aria-hidden="true"
    data-reveal
    data-reveal-edge
  >
    Perceptia
  </div>
</footer>

<style>
  .wordmark {
    font-size: clamp(5.25rem, 20.1vw, 18.125rem);
    background: linear-gradient(180deg, #ffffff 0%, #a9b5b1 45%, #56645f 70%, #03130f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
