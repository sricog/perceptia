---
import Shader from './Shader.astro';
import type { Service } from '../data/site';
interface Props { s: Service; href?: string; delay?: number }
const { s, href = `/servicios#${s.slug}`, delay = 0 } = Astro.props;
---

<a
  href={href}
  class="svc group relative flex flex-col rounded-[26px] border border-salvia/14 bg-card p-2.5 text-niebla transition-[border-color,transform] duration-500 hover:-translate-y-1 hover:border-aqua/40 hover:text-niebla"
  data-reveal
  style={`--d:${delay}s`}
>
  <div class="relative h-[220px] overflow-hidden rounded-[18px] md:h-[300px]">
    <Shader mode={s.shader.mode as any} variant={s.shader.variant} scale={s.shader.scale} px={s.shader.px} lens={s.shader.lens} />
  </div>
  <div class="grid grid-cols-1 items-end gap-6 px-4 sm:grid-cols-[1fr_auto] pb-4 pt-7 md:px-6.5 md:pb-5.5 md:pt-7.5">
    <div class="flex flex-col gap-3.5">
      <span class="font-mono text-[12px] font-medium tracking-[0.14em] text-aqua">{s.n}</span>
      <h3 class="text-[28px] font-semibold leading-[1.05] tracking-[-0.035em] md:text-[34px]">{s.title}</h3>
      <p class="max-w-[420px] text-[16px] leading-[1.55] text-salvia">{s.short}</p>
    </div>
    {
      s.price ? (
        <div class="flex flex-col gap-1.5 sm:items-end">
          <span class="mono-tag">Desde</span>
          <span class="text-[24px] font-[650] leading-none tracking-[-0.04em] md:text-[30px]">{s.price}</span>
        </div>
      ) : (
        <span class="whitespace-nowrap font-mono text-[13px] text-niebla">
          Propuesta <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
        </span>
      )
    }
  </div>
  <span class="pointer-events-none absolute inset-0 rounded-[26px] opacity-0 shadow-[0_0_0_1px_rgba(20,224,165,.35),0_30px_80px_-30px_rgba(20,224,165,.55)] transition-opacity duration-500 group-hover:opacity-100"></span>
</a>
