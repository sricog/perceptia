---
/**
 * Tarjeta de servicio del home («Lo que construimos»): la ilustración animada cuenta qué se
 * entrega; debajo, nombre y una sola frase. Toda la tarjeta enlaza al servicio.
 * El brillo que sigue al cursor lo mueve `spotlights()` (scripts/effects.ts).
 */
import ServiceViz from './ServiceViz.astro';
import type { Service } from '../data/site';
import { useI18n } from '../i18n';
interface Props { s: Service; delay?: number; class?: string }
const { s: svc, delay = 0, class: cls } = Astro.props;
const { t, href } = useI18n(Astro.url);
const s = { ...svc, ...t.services[svc.id] };
---

<a
  href={href('services', s.slug)}
  class:list={[
    'svc group relative flex flex-col overflow-hidden rounded-[1.625rem] border border-salvia/14 bg-card text-niebla transition-[border-color,translate,box-shadow] duration-500 hover:-translate-y-1 hover:border-aqua/45 hover:text-niebla hover:shadow-[0_1.875rem_5rem_-1.875rem_rgba(20,224,165,.5)]',
    cls,
  ]}
  data-spot
  data-reveal
  style={`--d:${delay}s`}
>
  <div class="h-[16.5rem] md:h-[19.5rem]"><ServiceViz id={svc.id} /></div>
  <div class="relative flex items-end justify-between gap-6 border-t border-salvia/12 p-6 md:p-8">
    <div class="flex flex-col gap-3">
      <h3 class="text-[1.75rem] font-semibold leading-[1.05] tracking-[-0.035em] md:text-[2.125rem]">{s.title}</h3>
      <p class="max-w-[26rem] text-[1rem] leading-[1.5] text-salvia">{s.short}</p>
    </div>
    <span
      class="grid size-11 flex-none place-items-center rounded-full border border-salvia/30 font-mono text-[1rem] leading-none transition-[background,color,border-color] duration-300 group-hover:border-aqua group-hover:bg-aqua group-hover:text-noche"
      aria-hidden="true"
    >
      →
    </span>
  </div>
  <span class="spot pointer-events-none absolute inset-0" aria-hidden="true"></span>
</a>
