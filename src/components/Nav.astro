---
import BinocularMark from './BinocularMark.astro';
import { useI18n, langs, routes, dict, fill, type RouteKey } from '../i18n';

interface Props { route?: RouteKey }
const { route } = Astro.props;
const { t, lang, href } = useI18n(Astro.url);

const links = [
  { label: t.nav.home, href: href('home'), match: routes.home[lang] },
  { label: t.nav.services, href: href('services'), match: routes.services[lang] },
  { label: t.nav.projects, href: href('projects'), match: routes.projects[lang] },
  { label: t.nav.process, href: href('process'), match: routes.process[lang] },
  { label: t.nav.contact, href: href('contact'), match: routes.contact[lang] },
];
// Página equivalente en cada idioma. El script la actualiza en cada navegación,
// porque este header se conserva entre páginas del mismo idioma.
const switcher = langs.map((l) => ({ l, short: dict(l).short, name: dict(l).name, href: routes[route ?? 'home'][l] }));
---

<header
  id="site-nav"
  transition:persist={`nav-${lang}`}
  class="fixed inset-x-0 top-0 z-50"
  data-open-label={t.a11y.openMenu}
  data-close-label={t.a11y.closeMenu}
>
  <div class="grid grid-cols-[1fr_auto] items-center px-5 py-4 lg:grid-cols-[1fr_auto_1fr] md:px-12 md:py-7">
    <a href={href('home')} class="flex items-center gap-3 text-[1.25rem] font-semibold tracking-[-0.02em] text-niebla hover:text-niebla" aria-label={t.a11y.home}>
      <BinocularMark id="nav" size={24} anim />
      <span>Perceptia</span>
    </a>

    <nav
      aria-label={t.a11y.mainNav}
      class="hidden gap-1.5 rounded-full border border-niebla/10 bg-noche/45 p-1.5 text-[0.875rem] font-[450] text-bruma backdrop-blur-xl lg:flex"
    >
      {
        links.map((l) => (
          <a href={l.href} data-nav-link data-match={l.match} class="rounded-full px-4 py-2.5 text-bruma transition-colors hover:bg-niebla/8 hover:text-niebla">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center justify-end gap-2">
      <div
        role="group"
        aria-label={t.a11y.language}
        class="flex h-11 items-center gap-0.5 rounded-full border border-niebla/15 bg-noche/50 p-1 font-mono text-[0.75rem] font-medium tracking-[0.08em] backdrop-blur-xl"
      >
        {
          switcher.map((s) =>
            s.l === lang ? (
              <span aria-current="true" class="flex h-full items-center rounded-full bg-niebla/12 px-2.5 text-niebla">
                {s.short}
              </span>
            ) : (
              <a
                href={s.href}
                hreflang={dict(s.l).htmlLang}
                lang={dict(s.l).htmlLang}
                data-lang-switch={s.l}
                data-home={routes.home[s.l]}
                aria-label={`${s.short} · ${fill(dict(s.l).a11y.switchTo, { lang: s.name })}`}
                class="flex h-full items-center rounded-full px-2.5 text-salvia transition-colors hover:text-niebla"
              >
                {s.short}
              </a>
            ),
          )
        }
      </div>
      <a
        href={href('contact')}
        class="hidden h-11 items-center rounded-full bg-niebla px-5 text-[0.875rem] font-semibold text-noche transition hover:bg-aqua hover:text-noche sm:flex"
      >
        {t.nav.cta}
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="relative flex size-11 items-center justify-center rounded-full border border-niebla/15 bg-noche/50 backdrop-blur-xl lg:hidden"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={t.a11y.openMenu}
      >
        <span class="nav-bar absolute h-px w-5 -translate-y-1 bg-niebla transition-transform duration-300"></span>
        <span class="nav-bar absolute h-px w-5 translate-y-1 bg-niebla transition-transform duration-300"></span>
      </button>
    </div>
  </div>

  <div
    id="nav-panel"
    inert
    class="pointer-events-none fixed inset-0 -z-10 flex flex-col justify-end bg-noche/95 px-5 pb-10 opacity-0 backdrop-blur-2xl transition-opacity duration-500 lg:hidden"
  >
    <nav aria-label={t.a11y.mobileNav} class="flex flex-col">
      {
        links.map((l) => (
          <a href={l.href} class="hairline border-t py-5 text-[2.5rem] font-semibold tracking-[-0.04em] text-niebla">
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href={href('contact')} class="btn btn-primary mt-8 w-full">{t.hero.primary}</a>
  </div>
</header>

<style>
  /* El fondo al hacer scroll va en un pseudo-elemento: un `backdrop-filter` en el propio header
     lo convertiría en el bloque contenedor de sus hijos `fixed` y el panel del menú quedaría
     encerrado en la franja del header en lugar de cubrir la pantalla. */
  #site-nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    border-bottom: 1px solid transparent;
    transition: background 0.5s, backdrop-filter 0.5s, border-color 0.5s;
  }
  #site-nav.is-scrolled:not(.is-open)::before {
    background: rgb(3 19 15 / 0.72);
    backdrop-filter: blur(1.125rem);
    border-bottom-color: rgb(143 176 165 / 0.12);
  }
  #site-nav.is-open #nav-panel {
    opacity: 1;
    pointer-events: auto;
  }
  #site-nav.is-open .nav-bar:first-child {
    translate: 0 0;
    transform: rotate(45deg);
  }
  #site-nav.is-open .nav-bar:last-child {
    translate: 0 0;
    transform: rotate(-45deg);
  }
  [data-nav-link][aria-current='page'] {
    background: rgb(238 245 242 / 0.1);
    color: var(--color-niebla);
  }
</style>

<script>
  // El header se conserva entre páginas del mismo idioma y se reemplaza al cambiar de idioma,
  // así que se busca de nuevo en cada navegación y se enlaza una sola vez por elemento.
  const getHeader = () => document.getElementById('site-nav');

  const setOpen = (header: HTMLElement, open: boolean, { restoreFocus = false } = {}) => {
    const toggle = header.querySelector<HTMLButtonElement>('#nav-toggle')!;
    const panel = header.querySelector<HTMLElement>('#nav-panel')!;
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? header.dataset.closeLabel : header.dataset.openLabel) ?? '');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    // Cerrado, el panel no recibe foco ni lo leen los lectores de pantalla. Abierto, lo que queda
    // detrás (todo menos el header) se desactiva para que el foco no se escape del menú.
    panel.inert = !open;
    for (const el of document.body.children) if (el !== header && el.tagName !== 'SCRIPT') (el as HTMLElement).inert = open;
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  };

  // Headers ya enlazados. No se marca con un atributo: al navegar, Astro sincroniza los atributos
  // del header persistente con los de la página nueva y la marca se borraba, así que cada
  // navegación sumaba otro listener y con un número par el botón abría y cerraba a la vez.
  const bound = new WeakSet<HTMLElement>();
  const bind = (header: HTMLElement) => {
    if (bound.has(header)) return;
    bound.add(header);
    header.querySelector('#nav-toggle')!.addEventListener('click', () => setOpen(header, !header.classList.contains('is-open')));
    header.querySelectorAll('#nav-panel a').forEach((a) => a.addEventListener('click', () => setOpen(header, false)));
  };

  const onScroll = () => getHeader()?.classList.toggle('is-scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('keydown', (e) => {
    const header = getHeader();
    if (e.key === 'Escape' && header?.classList.contains('is-open')) setOpen(header, false, { restoreFocus: true });
  });
  // Desde `lg` el panel no existe (lg:hidden): si estaba abierto, se cierra para no dejar la página desactivada.
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    const header = getHeader();
    if (e.matches && header?.classList.contains('is-open')) setOpen(header, false);
  });

  document.addEventListener('astro:page-load', () => {
    const header = getHeader();
    if (!header) return;
    bind(header);
    onScroll();
    setOpen(header, false);
    header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
      const match = a.dataset.match;
      if (match && location.pathname.replace(/\/$/, '') === match.replace(/\/$/, '')) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    // Enlace del otro idioma → página equivalente (la publica Base.astro en <link rel="alternate">).
    header.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
      const alt = document.querySelector<HTMLLinkElement>(`link[rel="alternate"][hreflang="${a.getAttribute('hreflang')}"]`);
      a.href = alt ? new URL(alt.href).pathname : a.dataset.home!;
    });
  });
</script>
